# Canonical origin for this deployment. Configure each environment separately.
# Production: https://efemero.rafael.run
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Private store only. Never expose this token with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
# Generate locally with npm run setup:secrets. Never commit actual values.
OPAQUE_SERVER_SETUP=
OPAQUE_SETUP_VERSION=1
HANDSHAKE_SEAL_KEY=
RATE_LIMIT_HMAC_KEY=
CRON_SECRET=
# Optional until the account area is configured. Sharing still requires the above.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
